{
  "compilerOptions": {
    "allowJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "ES2020"],
    "types": ["@docusaurus/module-type-aliases", "@docusaurus/types", "node"],
    "paths": {
      "@site/*": ["./*"]
    }
  },
  "include": ["src/", "docs/"],
  "exclude": [".docusaurus", "build"]
}
